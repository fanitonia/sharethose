{
  "plugins": [
    "@trivago/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "tailwindStylesheet": "./src/styles/index.css",
  "tailwindFunctions": ["clsx", "cva", "cn"],
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "importOrder": [
    "^react$",
    "<THIRD_PARTY_MODULES>",
    "^@/(.*)$",
    "^@lib/(.*)$",
    "^@utils/(.*)$",
    "^@context/(.*)$",
    "^@type/(.*)$",
    "^@hooks/(.*)$",
    "^@api/(.*)$",
    "^lucide-react$",
    "^@assets/(.*)$",
    "^@components/(.*)$",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
